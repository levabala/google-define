{
    "headers": [
        {
            "source": "/_next/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/api/trpc/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=300, must-revalidate"
                }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).css",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).png",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).jpg",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).svg",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).ico",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).woff2",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, must-revalidate"
                }
            ]
        }
    ]
}
